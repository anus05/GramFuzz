include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include requirements.txt
include grammars/demo.json
recursive-include gramfuzz/grammars *.json
recursive-include docs *.md
recursive-include examples *.py *.yaml *.yml
prune .git
exclude .gitignore
prune .github
prune .pytest_cache
prune .mypy_cache
prune .ruff_cache
prune .tox
prune .nox
prune .gramfuzz
prune build
prune dist
prune reports
prune venv
prune .venv
prune __pycache__
prune htmlcov
global-exclude *.py[cod] *.sqlite* *.db* *.env .env.* *.pem *.key *.p12 *.pfx *.secret *.secrets *.log
global-exclude evaluation-results*.json evaluation-results*.html
